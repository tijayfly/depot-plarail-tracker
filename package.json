{
  "name": "depot-plarail-tracker",
  "productName": "DEPOT",
  "version": "1.0.0",
  "description": "DEPOT: a local Plarail collection tracker (Electron)",
  "main": "main.js",
  "author": "TiJayFLY",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tijayfly.depot",
    "productName": "DEPOT",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "data/**"
    ],
    "win": {
      "target": "portable",
      "icon": "renderer/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "DEPOT-${version}-portable.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tijayfly/depot-plarail-tracker.git"
  }
}
